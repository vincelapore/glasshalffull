{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:3000",
          "https://glasshalffull.space",
          "https://www.glasshalffull.space"
        ],
        "methods": ["PUT", "HEAD"],
        "headers": ["Content-Type", "Cache-Control"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
