# Neon Serverless Postgres
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Neon Auth (Managed Better Auth)
# Auth URL from Neon Console → Branch → Auth → Configuration
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Owners can add/remove admins. Always includes vincemlapore@gmail.com.
OWNER_EMAILS=vincemlapore@gmail.com

# Optional extra admin emails (moderation only; cannot change roles)
ADMIN_EMAILS=

# Cloudflare R2 (S3-compatible). Secrets stay server-only.
# R2_ACCOUNT_ID is the hex ID in your S3 endpoint:
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Use the "Access Key ID" / "Secret Access Key" pair — not the Cloudflare API token (cfut_…).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=glasshalffull

# Public r2.dev origin for stored object keys (avatars/…webp, flyers/…webp, work/…webp).
# Copy the Public Development URL from R2 → glasshalffull → Settings.
# Neon stores only the key; this prefix can change without rewriting rows.
NEXT_PUBLIC_MEDIA_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
