# Neon Serverless Postgres
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Admin moderation password for /admin
ADMIN_PASSWORD=change-me

# Cloudflare R2 (S3-compatible). Secrets stay server-only.
# R2_ACCOUNT_ID is the hex ID in your S3 endpoint:
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Use the "Access Key ID" / "Secret Access Key" pair — not the Cloudflare API token (cfut_…).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=glasshalffull

# Public r2.dev origin for stored object keys (avatars/…webp, flyers/…webp).
# Copy the Public Development URL from R2 → glasshalffull → Settings.
# Neon stores only the key; this prefix can change without rewriting rows.
NEXT_PUBLIC_MEDIA_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
